# ==============================================================================
# Big Ola Virtual Currency Marketplace — Zero-Budget ($0) Cloud Template
# Copy to .env for local/dev-cloud testing. NEVER commit real secrets or URLs.
# Free Stack: Render Free Web Services + Neon Free PostgreSQL + Upstash Free Redis
# ==============================================================================

NODE_ENV=development
APP_NAME="Big Ola Marketplace"
SUPPLIER_PRIMARY_USERNAME=bigola2823

# --- Server & Frontend URLs ---
API_PORT=4000
API_HOST=0.0.0.0
# Local: http://localhost:3000 | Render Free: https://bigola-web.onrender.com
WEB_BASE_URL=http://localhost:3000
# Optional comma-separated CORS allowlist (defaults to WEB_BASE_URL if omitted)
CORS_ORIGINS=http://localhost:3000
# Exposed ONLY to Next.js frontend (never put DB/Redis/session secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Neon Free PostgreSQL (Primary persistent source of truth) ---
# Pooled connection string (with -pooler host & ?sslmode=require) for runtime queries
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/bigola_dev?sslmode=require
# Direct (non-pooled) connection string for Prisma migrations & admin scripts
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/bigola_dev?sslmode=require

# --- Upstash Redis (TLS TCP rediss:// URL — do NOT use the REST https:// URL) ---
REDIS_URL=rediss://default:PASSWORD@example-endpoint.upstash.io:6379
QUEUE_PREFIX=bigola_mp_dev

# --- Authentication, Sessions & Encryption ---
# Generate fresh 64-char hex values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_only_session_secret_replace_in_production_32chars
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_TTL_HOURS=24
OWNER_REQUIRE_2FA=true

# --- Object Storage (Payment Proof Screenshots - Phase 4+) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- LagosLife Integration Guardrails (Disabled in Phase 2) ---
DISBURSEMENT_ENABLED=false
LAGOSLIFE_BASE_URL=https://lagoslife.app
LAGOSLIFE_MAX_CHUNK_AMOUNT=100000000000
LAGOSLIFE_COOLDOWN_MS=30500
